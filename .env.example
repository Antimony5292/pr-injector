# GitHub API token (required for mining PRs)
PRI_GITHUB_TOKEN=your_github_token_here

# LLM Provider: "azure" or "litellm"
PRI_LLM_PROVIDER=azure

# Azure OpenAI Configuration (when PRI_LLM_PROVIDER=azure)
# Requires `az login` for Azure AD authentication
PRI_AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
PRI_AZURE_DEPLOYMENT=your-deployment-name
PRI_AZURE_API_VERSION=2024-12-01-preview

# LLM Configuration (when PRI_LLM_PROVIDER=litellm)
PRI_LLM_API_KEY=your_api_key_here
PRI_LLM_MODEL=claude-sonnet-4-20250514

# Pipeline settings
PRI_MAX_WORKERS=4
PRI_WORKSPACE_DIR=.pri-workspace
PRI_OUTPUT_DIR=./benchmark_dataset

# Verifier settings
PRI_TEST_TIMEOUT_SECONDS=300
PRI_BLAST_RADIUS_THRESHOLD=0.1

# Logging
PRI_LOG_LEVEL=INFO
PRI_LOG_FORMAT=console
